NODE_ENV=development
# On Railway leave HOST and PORT unset: the server listens on 0.0.0.0 and the
# port Railway gives it.
HOST=127.0.0.1
PORT=8000
# Only needed when the web app is hosted at a different address from the API.
# When the API serves the web app (the Railway setup in DEPLOY.md) leave it as is.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DATABASE_URL=postgresql://minders:@127.0.0.1:5432/minders
DATABASE_SSL=false
# bcrypt cost for PIN hashing (10 is a good default; tests use 4)
BCRYPT_COST=10
# Admin session lifetime in days (renews while in use)
SESSION_DAYS=7
# Farmer session lifetime in days. Farmers work offline for long periods, so
# their sessions are long and renew every time the app reaches the server.
FARMER_SESSION_DAYS=180
# AES-256 key for revealing admin access codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, access codes remain hash-only and cannot be revealed later.
CREDENTIAL_KEY=

# PIN reset by SMS. Options: disabled | console | twilio | africastalking
# "console" prints the code to the server log and is allowed only outside production.
SMS_PROVIDER=console
# Twilio trial credit works for Liberia (+231); trial accounts can only send to verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Africa's Talking alternative (sandbox is free; confirm live Liberia delivery before launch).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Apply pending database migrations when the server starts.
# Default: on in development, off in production (run `npm run migrate` when deploying).
# AUTO_MIGRATE=true

# First admin, created when the server starts and the database has no admin yet.
# Set these on Railway instead of running admin:create in a terminal. After the
# first start you can remove ADMIN_PIN; the account keeps working.
# ADMIN_NAME="Your Name"
# ADMIN_ACCESS_CODE=MND-CHANGE1
# ADMIN_PIN=
# ADMIN_PHONE=0770000002

# Shared tester login for judges (home page shows it). The server creates this
# admin, or resets its PIN, at start-up. It cannot change its code or PIN or
# send SMS. Delete both to switch it off.
# DEMO_ADMIN_ACCESS_CODE=Minister-Demo
# DEMO_ADMIN_PIN=112233

# Weather (Open-Meteo, no key needed). One forecast per county is reused for
# WEATHER_CACHE_MINUTES. Set WEATHER_PROVIDER=off to switch weather off.
# WEATHER_CACHE_MINUTES=30
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_PROVIDER=off
# Heavy-rain alerts (in-app + SMS when the farmer allows it).
# WEATHER_ALERTS=off
# WEATHER_ALERT_HOURS=6
# WEATHER_ALERT_MM=30

# USSD menu (Africa's Talking). Off until set. Callback URL:
#   https://<backend>/api/ussd?key=<USSD_SECRET>
# USSD_SECRET=
